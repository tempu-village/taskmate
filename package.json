{
  "name": "obsidian-taskmate",
  "version": "0.7.2",
  "private": true,
  "description": "A simple, local-first Todoist-style task list for Obsidian.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "deploy": "bash scripts/deploy-to-vault.sh",
    "dev": "node esbuild.config.mjs",
    "validate:localization": "python3 scripts/validate_localization.py",
    "validate:release": "node scripts/validate-release.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck && tsc -p test/e2e --noEmit",
    "test": "vitest run",
    "test:e2e": "wdio run ./wdio.conf.mts"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "@types/sortablejs": "^1.15.8",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.8.7",
    "obsidian-launcher": "^3.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  }
}
